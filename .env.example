# floffi — local environment overrides.
#
# Copy this file to .env (which is gitignored) and fill in the values
# you actually need. start.sh auto-loads .env if present, and the
# `floffi serve` binary takes `--env-file <path>` for custom paths.
#
# Shell environment ALWAYS wins over the .env file, so the same file
# can hold safe defaults that you still override per-shell when needed.

# ── Public URL ────────────────────────────────────────────────────────
# Base URL the email-verify / password-reset links should point at.
# Must match the address the browser actually hits — otherwise the
# user clicks a localhost link from their phone and gets nowhere.
FLOFFI_PUBLIC_URL=http://localhost:8081

# ── SMTP — outbound email (verify / reset / new-device alerts) ────────
#
# When FLOFFI_SMTP_HOST is empty the server falls back to a stdout
# "outbox" printer (you'll see the link in the terminal). Set the
# variables below to deliver real email instead.
#
# Gmail App Password setup:
#   1. Enable 2-Step Verification:    https://myaccount.google.com/security
#   2. Generate an App Password:      https://myaccount.google.com/apppasswords
#      → pick "Mail" / "Other (custom name) → floffi"
#      → Google shows a 16-character password (spaces optional).
#   3. Paste that 16-char string into FLOFFI_SMTP_PASS below.
#   4. FLOFFI_SMTP_USER and FLOFFI_SMTP_FROM must be the same Gmail
#      address you generated the App Password under — Gmail enforces
#      sender == authenticated user.
#
# Free-tier limit: Gmail SMTP caps at ~500 messages/day, more than
# enough for local testing.
FLOFFI_SMTP_HOST=smtp.gmail.com
FLOFFI_SMTP_PORT=587
FLOFFI_SMTP_USER=your.address@gmail.com
FLOFFI_SMTP_PASS=xxxx xxxx xxxx xxxx
FLOFFI_SMTP_FROM=your.address@gmail.com

# ── JWT secret ────────────────────────────────────────────────────────
# In dev (FLOFFI_PROD != "1") an ephemeral secret is generated per
# boot if this is empty. In prod the server refuses to start without
# a value. Generate one with: openssl rand -base64 48
# FLOFFI_JWT_SECRET=

# ── Session lifetime ──────────────────────────────────────────────────
# How long a login session (access token + access cookie) stays valid.
# Accepts a Go duration string: "9h", "30m", "90m", "1h30m", etc.
# Empty or invalid → defaults to 9h. The 7-day refresh cookie still
# silently renews the session in the background regardless of this value.
# FLOFFI_SESSION_TTL=9h

# ── Production hardening ──────────────────────────────────────────────
# Set to "1" to enable Secure-cookie + strict CSRF behaviour and force
# FLOFFI_JWT_SECRET. Leave unset for local dev.
# FLOFFI_PROD=1
